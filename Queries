| tstats summariesonly=t count min(_time) as firstTime max(_time) as lastTime
    from datamodel=Network_Resolution
    where nodename=DNS DNS.message_type=Query
    by DNS.src DNS.query sourcetype
| `drop_dm_object_name("DNS")`
| lookup rmm_tools URI AS query OUTPUT RMM_Tool
| search RMM_Tool=*
| eval duration_hours = round((lastTime - firstTime) / 3600, 2)
| where count > 10 OR duration_hours > 24
| stats 
    sum(count) as total_lookups
    min(firstTime) as firstTime 
    max(lastTime) as lastTime 
    values(query) as domains
    values(sourcetype) as sourcetypes
    by src, RMM_Tool
| eval duration_hours = round((lastTime - firstTime) / 3600, 2)
| `security_content_ctime(firstTime)`
| `security_content_ctime(lastTime)`
| sort - total_lookups


| tstats summariesonly=t count min(_time) as firstTime max(_time) as lastTime
    from datamodel=Network_Resolution
    where nodename=DNS DNS.message_type=Query
    by DNS.src DNS.query
