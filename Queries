| inputlookup urlhaus_iocs.csv
| search url="*$search_term$*" OR tags="*$search_term$*"
| eval Source="URLhaus", IOC=url, Type="URL", Detail=threat, Info=tags
| table Source IOC Type Detail Info
| append
    [| inputlookup threatfox_iocs.csv
    | search ioc="*$search_term$*" OR malware="*$search_term$*"
    | eval Source="ThreatFox", IOC=ioc, Type=ioc_type, Detail=malware, Info=threat_type
    | table Source IOC Type Detail Info]
| append
    [| inputlookup feodo_c2.csv
    | search dst_ip="*$search_term$*" OR hostname="*$search_term$*"
    | eval Source="Feodo C2", IOC=dst_ip, Type="C2 IP", Detail=malware, Info=hostname
    | table Source IOC Type Detail Info]
| append
    [| inputlookup malwarebazaar_hashes.csv
    | search sha256_hash="*$search_term$*" OR md5_hash="*$search_term$*" OR tags="*$search_term$*"
    | eval Source="MalwareBazaar", IOC=sha256_hash, Type=file_type, Detail=tags, Info=file_name
    | table Source IOC Type Detail Info]
| sort Source
