indicator="*$search_term$*"
| stats latest(type) AS "IOC Type",
    latest(malicious_confidence) AS Confidence,
    values(actors{}) AS Actors,
    values(malware_families{}) AS "Malware Families",
    values(threat_types{}) AS "Threat Types",
    values(kill_chains{}) AS "Kill Chain",
    values(labels{}.name) AS Labels,
    latest(published_date) AS Published,
    latest(last_updated) AS "Last Updated"
    by indicator
| rename indicator AS IOC
| eval Actors=mvjoin(Actors, ", "),
    "Malware Families"=mvjoin('Malware Families', ", "),
    "Threat Types"=mvjoin('Threat Types', ", "),
    "Kill Chain"=mvjoin('Kill Chain', ", "),
    Labels=mvjoin(Labels, ", ")
| table IOC "IOC Type" Confidence Actors "Malware Families" "Threat Types" "Kill Chain" Labels Published "Last Updated"
| sort - Confidence

value="*$search_term$*"
| stats latest(type) AS "IOC Type",
    latest(mscore) AS MScore,
    values(attributed_associations{}.name) AS Associations,
    values(attributed_associations{}.type) AS Assoc_Type,
    values(associated_hashes{}.value) AS Hashes,
    values(sources{}.source_name) AS Sources,
    latest(first_seen) AS "First Seen",
    latest(last_seen) AS "Last Seen"
    by value
| rename value AS IOC
| eval Associations=mvjoin(Associations, ", "),
    Assoc_Type=mvjoin(Assoc_Type, ", "),
    Hashes=mvjoin(Hashes, ", "),
    Sources=mvjoin(Sources, ", ")
| table IOC "IOC Type" MScore Associations Assoc_Type Hashes Sources "First Seen" "Last Seen"
| sort - MScore
