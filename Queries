  "dataSources": {
    "ds_urlhaus_count": {
      "type": "ds.search",
      "options": {
        "query": "| inputlookup urlhaus_iocs.csv | search url=\"*$search_term$*\" OR tags=\"*$search_term$*\" | stats count",
        "queryParameters": {
          "earliest": "-30d@d",
          "latest": "now"
        }
      }
    },
    "ds_threatfox_count": {
      "type": "ds.search",
      "options": {
        "query": "| inputlookup threatfox_iocs.csv | search ioc=\"*$search_term$*\" OR malware=\"*$search_term$*\" | stats count",
        "queryParameters": {
          "earliest": "-30d@d",
          "latest": "now"
        }
      }
    },
    "ds_feodo_count": {
      "type": "ds.search",
      "options": {
        "query": "| inputlookup feodo_c2.csv | search dst_ip=\"*$search_term$*\" OR hostname=\"*$search_term$*\" | stats count",
        "queryParameters": {
          "earliest": "-30d@d",
          "latest": "now"
        }
      }
    },
    "ds_bazaar_count": {
      "type": "ds.search",
      "options": {
        "query": "| inputlookup malwarebazaar_hashes.csv | search sha256_hash=\"*$search_term$*\" OR md5_hash=\"*$search_term$*\" OR tags=\"*$search_term$*\" OR file_name=\"*$search_term$*\" | stats count",
        "queryParameters": {
          "earliest": "-30d@d",
          "latest": "now"
        }
      }
    },
    "ds_kev_count": {
      "type": "ds.search",
      "options": {
        "query": "| inputlookup cisa_kev.csv | search cveID=\"*$search_term$*\" OR vendorProject=\"*$search_term$*\" OR product=\"*$search_term$*\" | stats count",
        "queryParameters": {
          "earliest": "-30d@d",
          "latest": "now"
        }
      }
    },
    "ds_urlhaus": {
      "type": "ds.search",
      "options": {
        "query": "| inputlookup urlhaus_iocs.csv | search url=\"*$search_term$*\" OR tags=\"*$search_term$*\" | rename url AS \"URL\", urlhaus_status AS \"Status\", threat AS \"Threat\", tags AS \"Tags\", date_added AS \"Date Added\" | table URL Status Threat Tags \"Date Added\"",
        "queryParameters": {
          "earliest": "-30d@d",
          "latest": "now"
        }
      }
    },
    "ds_threatfox": {
      "type": "ds.search",
      "options": {
        "query": "| inputlookup threatfox_iocs.csv | search ioc=\"*$search_term$*\" OR malware=\"*$search_term$*\" | rename ioc AS \"IOC\", ioc_type AS \"IOC Type\", threat_type AS \"Threat Type\", malware AS \"Malware\", confidence_level AS \"Confidence\", first_seen AS \"First Seen\", last_seen AS \"Last Seen\" | table IOC \"IOC Type\" \"Threat Type\" Malware Confidence \"First Seen\" \"Last Seen\"",
        "queryParameters": {
          "earliest": "-30d@d",
          "latest": "now"
        }
      }
    },
    "ds_feodo": {
      "type": "ds.search",
      "options": {
        "query": "| inputlookup feodo_c2.csv | search dst_ip=\"*$search_term$*\" OR hostname=\"*$search_term$*\" | rename dst_ip AS \"C2 IP\", hostname AS \"Hostname\", dst_port AS \"Port\", country AS \"Country\", malware AS \"Malware\", first_seen AS \"First Seen\", last_seen AS \"Last Seen\" | table \"C2 IP\" Hostname Port Country Malware \"First Seen\" \"Last Seen\"",
        "queryParameters": {
          "earliest": "-30d@d",
          "latest": "now"
        }
      }
    },
    "ds_bazaar": {
      "type": "ds.search",
      "options": {
        "query": "| inputlookup malwarebazaar_hashes.csv | search sha256_hash=\"*$search_term$*\" OR md5_hash=\"*$search_term$*\" OR tags=\"*$search_term$*\" OR file_name=\"*$search_term$*\" | rename sha256_hash AS \"SHA256\", md5_hash AS \"MD5\", sha1_hash AS \"SHA1\", file_name AS \"Filename\", file_type AS \"File Type\", tags AS \"Tags\", reporter AS \"Reporter\", first_seen AS \"First Seen\" | table SHA256 MD5 SHA1 Filename \"File Type\" Tags Reporter \"First Seen\"",
        "queryParameters": {
          "earliest": "-30d@d",
          "latest": "now"
        }
      }
    },
    "ds_kev": {
      "type": "ds.search",
      "options": {
        "query": "| inputlookup cisa_kev.csv | search cveID=\"*$search_term$*\" OR vendorProject=\"*$search_term$*\" OR product=\"*$search_term$*\" | rename cveID AS \"CVE\", vendorProject AS \"Vendor\", product AS \"Product\", vulnerabilityName AS \"Vulnerability\", dateAdded AS \"Date Added\", dueDate AS \"Patch Due\", shortDescription AS \"Description\" | table CVE Vendor Product Vulnerability Description \"Date Added\" \"Patch Due\"",
        "queryParameters": {
          "earliest": "-30d@d",
          "latest": "now"
        }
      }
    }
  },
