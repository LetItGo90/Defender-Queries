| where SoftwareName has_any (RMMSoftware)
| where not(SoftwareName has_any (SanctionedRMM))
| summarize 
    Devices = make_set(DeviceName),
    DeviceCount = dcount(DeviceName)
    by SoftwareName, SoftwareVendor
| sort by DeviceCount desc
