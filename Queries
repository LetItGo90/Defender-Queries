  "dataSources": {
    "ip_lookup_ds": {
      "type": "ds.search",
      "options": {
        "query": "| makeresults | eval search_indicator=\"$ti_input.value$\" | lookup feodo_c2.csv dst_ip AS search_indicator OUTPUT malware AS feodo_malware, c2_status, last_online AS feodo_last_seen | lookup threatfox_iocs.csv ioc AS search_indicator OUTPUT threat_type AS tf_threat_type, malware AS tf_malware, confidence_level AS tf_confidence | eval feodo_hit=if(isnotnull(feodo_malware), \"HIT\", \"MISS\") | eval threatfox_hit=if(isnotnull(tf_malware), \"HIT\", \"MISS\") | table search_indicator, feodo_hit, feodo_malware, c2_status, feodo_last_seen, threatfox_hit, tf_malware, tf_threat_type, tf_confidence"
      }
    },
    "hash_lookup_ds": {
      "type": "ds.search",
      "options": {
        "query": "| makeresults | eval search_hash=\"$hash_input.value$\" | lookup malwarebazaar_hashes.csv sha256_hash AS search_hash OUTPUT signature, file_type, first_seen AS mb_first_seen | lookup threatfox_iocs.csv ioc AS search_hash OUTPUT malware AS tf_malware, threat_type AS tf_threat_type | eval bazaar_hit=if(isnotnull(signature), \"HIT\", \"MISS\") | eval threatfox_hit=if(isnotnull(tf_malware), \"HIT\", \"MISS\") | table search_hash, bazaar_hit, signature, file_type, mb_first_seen, threatfox_hit, tf_malware, tf_threat_type"
      }
    },
    "cve_lookup_ds": {
      "type": "ds.search",
      "options": {
        "query": "| makeresults | eval search_cve=\"$cve_input.value$\" | lookup cisa_kev.csv cveID AS search_cve OUTPUT vendorProject, product, vulnerabilityName, shortDescription, knownRansomwareCampaignUse, dueDate, dateAdded | eval kev_hit=if(isnotnull(vendorProject), \"ON KEV\", \"NOT ON KEV\") | eval ransomware_flag=if(knownRansomwareCampaignUse==\"Known\", \"YES\", \"Unknown\") | table search_cve, kev_hit, vendorProject, product, vulnerabilityName, ransomware_flag, dueDate, dateAdded, shortDescription"
      }
    },
    "url_lookup_ds": {
      "type": "ds.search",
      "options": {
        "query": "| makeresults | eval search_url=\"$url_input.value$\" | lookup urlhaus_iocs.csv url AS search_url OUTPUT url_status, threat, tags, dateadded AS urlhaus_dateadded | eval urlhaus_hit=if(isnotnull(threat), \"HIT\", \"MISS\") | table search_url, urlhaus_hit, url_status, threat, tags, urlhaus_dateadded"
      }
    }
  },
