DeviceTvmSoftwareInventory
| where SoftwareName has_any (
    "anydesk", "teamviewer", "screenconnect", "connectwise", 
    "rustdesk", "meshcentral", "splashtop", "atera",
    "supremo", "ultraviewer", "ammyy", "aeroadmin",
    "getscreen", "fleetdeck", "simplehelp", "bomgar",
    "netbird", "tailscale", "zerotier", "ngrok",
    "todesk", "sunlogin", "hoptodesk", "litemanager",
    "remotepc", "action1", "level", "syncro",
    "ninja", "datto", "kaseya", "pulseway",
    "logmein", "gotoassist", "beyondtrust", "radmin",
    "vnc", "realvnc", "tightvnc", "ultravnc",
    "remoteutilities", "remote utilities", "meshagent",
    "tacticalrmm", "comodo", "itarian", "zoho assist"
)
| summarize Devices = make_set(DeviceName) by SoftwareName, SoftwareVendor
| extend DeviceCount = array_length(Devices)
| sort by DeviceCount desc

DeviceProcessEvents
| where Timestamp > ago(7d)
| where FileName has_any (
    "anydesk", "teamviewer", "screenconnect", 
    "rustdesk", "meshagent", "splashtop", "atera",
    "supremo", "ultraviewer", "ammyy", "aeroadmin",
    "netbird", "tailscale", "zerotier", "ngrok",
    "todesk", "sunlogin", "hoptodesk", "litemanager",
    "remotepc", "action1", "syncromsp",
    "logmein", "gotoassist", "bomgar", "radmin",
    "tvnserver", "vncserver", "winvnc",
    "remoteutilities", "rutserv", "rfusclient",
    "tacticalrmm", "meshcentral"
)
| summarize 
    FirstSeen = min(Timestamp),
    LastSeen = max(Timestamp),
    ExecutionCount = count()
    by DeviceName, FileName, FolderPath
| sort by ExecutionCount desc
